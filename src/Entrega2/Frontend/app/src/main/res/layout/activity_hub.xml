<?xml version='1.0' encoding='utf-8'?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/screenRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background" android:paddingHorizontal="16dp">
    <ImageView android:id="@+id/brandLogo" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginTop="12dp" android:src="@drawable/logo" android:contentDescription="@string/app_name" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" />
