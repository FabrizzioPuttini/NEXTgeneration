# Copie este arquivo para .env (cp .env.example .env) e preencha com os
# valores do SEU projeto Supabase. Nunca commite o .env com valores reais.

# Painel do Supabase → Project Settings → API → Project URL
SUPABASE_URL=

# Painel do Supabase → Project Settings → API → anon public key
# (nunca usar a service_role key aqui — veja o README para o motivo)
SUPABASE_ANON_KEY=

# Porta local do servidor Express. Na Vercel, a porta é gerenciada pela
# plataforma e esta variável não é necessária no ambiente publicado.
PORT=3000
