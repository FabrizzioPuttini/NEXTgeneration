<?xml version="1.0" encoding="utf-8"?>

<!-- Card de um único encontro/aula na lista da Agenda. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/borda"
    android:backgroundTint="@color/menuColor"
    android:padding="16dp"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textDataHora"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="01/03 · 19:00 - 21:00"
            android:textColor="@color/selected_green"
            android:textStyle="bold"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/textStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Presença confirmada"
            android:textSize="12sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/textTituloEncontro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Aula 1 — Lógica de programação"
        android:textColor="@color/objectColor"
        android:textStyle="bold"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/textCurso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Introdução à Programação"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/textLocal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="📍 Sala 3"
        android:textSize="13sp" />

</LinearLayout>
